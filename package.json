{
  "name": "local-coding-agent-desktop",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.cjs -i desktop/tailwind.css -o local_coding_agent/desktop/assets/tailwind.css --minify",
    "build:icons": "node tools/build-desktop-assets.mjs",
    "build:frontend": "npm run build:css && npm run build:icons",
    "build:sidecar": "python tools/build_sidecar.py",
    "build": "npm run build:frontend && npm run build:sidecar",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "lucide": "0.468.0",
    "tailwindcss": "3.4.17"
  }
}
